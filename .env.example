OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=liquid/lfm-2.5-2.6b:free
 
# Global Library sync flag
ENABLE_GLOBAL_SYNC=true
VITE_ENABLE_GLOBAL_SYNC=true

# Cloudflare R2 (Read-only setup)
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET_NAME=your-r2-bucket-name
R2_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-read-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-read-secret-access-key
R2_PUBLIC_BASE_URL=https://your-r2-public-url.r2.dev

# Storage Mutation & Dispatch (Server-side only — Gated behind Admin JWT Auth)
# Non-obvious environment variable names for write credentials
STORAGE_DISPATCH_TOKEN_ID=your-r2-write-access-key-id
STORAGE_DISPATCH_TOKEN_SECRET=your-r2-write-secret-access-key

# Supabase (Read-only setup)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Database Pipeline Dispatch (Server-side only — Gated behind Admin JWT Auth)
# Non-obvious environment variable name for write credential
PIPELINE_CATALOG_SYNC_TOKEN=your-supabase-service-secret-key

# Firebase (server-side only — NOT prefixed with VITE_ to prevent client bundle auto-exposure)
# Injected at build time via Vite `define` in vite.config.ts — no network call, no API endpoint
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Session Administration JWT (stored only server-side, minimum 32 chars)
ADMIN_JWT_SECRET=your-jwt-secret-min-32-characters

# Razorpay Payment Gateway (Community Support)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id


