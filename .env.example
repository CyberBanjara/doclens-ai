OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-20b:free

# Cloudflare R2 (S3-compatible) — durable primary store for uploaded PDF bytes.
# Create a bucket + API token at https://dash.cloudflare.com -> R2 -> Manage API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=doclens-documents
